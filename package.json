{
  "name": "nightfall-launcher",
  "productName": "Nightfall Launcher",
  "version": "1.3.0",
  "description": "A game launcher that tracks your real play time",
  "main": "src/main.js",
  "author": "Nightfall",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable",
    "release": "electron-builder --win nsis portable --publish always"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "app.nightfall.launcher",
    "productName": "Nightfall Launcher",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "portable",
        "nsis"
      ]
    },
    "portable": {
      "artifactName": "NightfallLauncher-Portable-${version}.exe"
    },
    "nsis": {
      "artifactName": "NightfallLauncher-Setup-${version}.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "KYOO-DEVV",
        "repo": "nightfall-launcher",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "@xhayper/discord-rpc": "1.2.0",
    "electron-updater": "6.3.9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/KYOO-DEVV/nightfall-launcher.git"
  }
}
