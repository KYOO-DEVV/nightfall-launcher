{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nightfall Launcher",
  "version": "2.6.0",
  "identifier": "app.nightfall.launcher",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Nightfall Launcher",
        "width": 1360,
        "height": 840,
        "minWidth": 1024,
        "minHeight": 640,
        "decorations": false,
        "visible": false,
        "center": true,
        "backgroundColor": "#0b0b0d",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost https: data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$APPLOCALDATA/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "Nightfall",
    "copyright": "Copyright (c) 2026 KYOO-DEVV",
    "category": "Game",
    "shortDescription": "Every game you own, in one place.",
    "homepage": "https://github.com/KYOO-DEVV/nightfall-launcher",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./installer-hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "sidebarImage": "installer/sidebar.bmp",
        "headerImage": "installer/header.bmp",
        "languages": ["English", "French"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY4NTA5QTUyRDFDREJDQTYKUldTbXZNM1JVcHBRK0MrRWtyclNBSkpCRjVjNWdNZUZ4TlVNbUl5NEdKWnk5Q1M4cm8rTnNib1UK",
      "endpoints": [
        "https://github.com/KYOO-DEVV/nightfall-launcher/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
